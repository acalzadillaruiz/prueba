# ── Base de datos / Database ─────────────────────────────────────────
# `npm run db:up` arranca un Postgres 16 local (o `docker compose up -d`).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newplace

# ── Auth.js v5 ──────────────────────────────────────────────────────
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=                   # opcional: activa «Continuar con Google»
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH=false     # true cuando AUTH_GOOGLE_ID está configurado
# «Entrar como…» sin contraseña con las cuentas seed. Apagado por defecto: nunca en producción con usuarios reales.
# Demo local / e2e / capturas: pon ambos a true en apps/web/.env.local.
DEMO_AUTH=false
NEXT_PUBLIC_DEMO_AUTH=false

# ── Google Maps (opcional: sin key se usa el mapa ilustrado) ─────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=        # Map ID con estilo vectorial (opcional)

# ── IA (opcional: sin key se usa HeuristicProvider local) ───────────
AI_BASE_URL=                      # p. ej. https://api.x.ai/v1 o https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
GEMINI_API_KEY=                   # solo para `npm run photos -w apps/web` (fotos IA de los listings)

# ── Almacenamiento de fotos ─────────────────────────────────────────
STORAGE=local                     # local | s3 (stub)
UPLOAD_DIR=                       # por defecto <repo>/uploads

# ── Tareas programadas ──────────────────────────────────────────────
CRON_SECRET=                      # Bearer para POST /api/v1/alerts/run (digest de alertas)

# ── URL pública ─────────────────────────────────────────────────────
# Origen canónico (sitemap, robots, canonical, enlaces de email). Necesaria en BUILD y en runtime: las páginas
# públicas se generan estáticamente. Orden: APP_URL → NEXT_PUBLIC_APP_URL → VERCEL_PROJECT_PRODUCTION_URL → VERCEL_URL.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── IP real del cliente para los límites por IP (fuera de Vercel) ───
# Sin ninguna, X-Forwarded-For no se considera fiable y todos los clientes comparten un cubo («direct»). Ver docs/DEPLOY.md.
TRUSTED_IP_HEADER=                # cabecera que tu proxy SOBRESCRIBE: x-real-ip | cf-connecting-ip | …
TRUSTED_PROXY_HOPS=               # nº de proxies propios que AÑADEN a X-Forwarded-For (nginx delante → 1)

# ── Emails reales (opcional: sin clave se registran en la bandeja «Enviados» como SIMULATED, sin enviarse) ──
RESEND_API_KEY=
EMAIL_FROM=                       # p. ej. "New Place <hola@tudominio.com>" (dominio verificado en Resend)

# ── Rate limiting distribuido (opcional: sin esto se usa Postgres) ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Monitoreo de errores (opcional) ──
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1     # 0–1, fracción de trazas de rendimiento enviadas a Sentry
