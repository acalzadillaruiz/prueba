{
  "name": "new-place",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "build:host": "npm run generate -w packages/db && npm run db:setup && npm run build -w apps/web",
    "test": "npm run test --workspaces --if-present",
    "shots": "node scripts/capture.mjs",
    "db:up": "bash scripts/db-local.sh",
    "db:push": "npm run push -w packages/db",
    "db:migrate": "npm run migrate -w packages/db",
    "db:seed": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json tsx packages/db/prisma/seed.ts",
    "db:reset": "npm run migrate:deploy -w packages/db && npm run db:seed",
    "lint": "npm run lint -w apps/web",
    "e2e": "npm run e2e -w apps/web",
    "db:setup": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json tsx packages/db/prisma/setup.ts",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "devDependencies": {
    "lighthouse": "^12.8.2",
    "playwright": "1.56.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "browserslist": "^4.28.7",
    "deepmerge-ts": "^8.0.0",
    "@playwright/test": "1.56.1",
    "playwright": "1.56.1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
